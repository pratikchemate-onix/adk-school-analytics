# ===================================
# CUSTOM MODEL CONFIGURATION
# ===================================
# Copy these to your .env file after getting your API key

# Option 1: Together AI (RECOMMENDED - Easiest!)
# Get your key from: https://api.together.ai/settings/api-keys
CUSTOM_MODEL_API_KEY=your_together_ai_key_here
CUSTOM_MODEL_BASE_URL=https://api.together.ai/v1
CUSTOM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-Turbo
# Pricing: $0.30/M input tokens, $0.30/M output tokens

# Option 2: Together AI - Qwen2.5-Coder (Better for SQL!)
# CUSTOM_MODEL_API_KEY=your_together_ai_key_here
# CUSTOM_MODEL_BASE_URL=https://api.together.ai/v1
# CUSTOM_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct
# Note: Check if available, pricing may vary

# Option 3: OpenRouter (Multiple models)
# Get your key from: https://openrouter.ai/keys
# CUSTOM_MODEL_API_KEY=your_openrouter_key_here
# CUSTOM_MODEL_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_MODEL_NAME=qwen/qwen-2.5-coder-32b-instruct
# Check pricing at: https://openrouter.ai/models

# Option 4: Replicate
# Get your key from: https://replicate.com/account/api-tokens
# CUSTOM_MODEL_API_KEY=your_replicate_key_here
# Note: Replicate needs different client, use Together AI for now

# ===================================
# ENABLE CUSTOM MODEL
# ===================================
USE_CUSTOM_MODEL=true

# Keep your existing settings below
ROOT_AGENT_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
