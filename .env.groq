# ===================================
# GROQ CONFIGURATION
# ===================================
# Copy these to your .env file

# Groq API Configuration
CUSTOM_MODEL_API_KEY=your_groq_api_key_here
CUSTOM_MODEL_BASE_URL=https://api.groq.com/openai/v1
CUSTOM_MODEL_NAME=llama-3.3-70b-versatile

# Alternative Models on Groq:
# For SQL/Analytics - RECOMMENDED:
# CUSTOM_MODEL_NAME=llama-3.3-70b-versatile         (Best quality, 128K context)
# CUSTOM_MODEL_NAME=llama-3.1-70b-versatile         (Great balance)
# CUSTOM_MODEL_NAME=llama-3.2-90b-text-preview      (Good for text)
# CUSTOM_MODEL_NAME=mixtral-8x7b-32768              (Fast, good quality)
# CUSTOM_MODEL_NAME=gemma2-9b-it                    (Fastest, smaller)

# Enable custom model
USE_CUSTOM_MODEL=true

# ===================================
# GROQ MODELS & PRICING
# ===================================

# FREE TIER LIMITS:
# - 30 requests per minute
# - 14,400 requests per day
# - 6,000 tokens per minute

# PAID TIER (when you exceed free tier):
# Model: llama-3.3-70b-versatile
#   - Input:  $0.59 per 1M tokens
#   - Output: $0.79 per 1M tokens
#   - Context: 128K tokens
#   - Speed: VERY FAST!

# Model: llama-3.1-70b-versatile
#   - Input:  $0.59 per 1M tokens
#   - Output: $0.79 per 1M tokens
#   - Context: 128K tokens

# Model: mixtral-8x7b-32768
#   - Input:  $0.24 per 1M tokens
#   - Output: $0.24 per 1M tokens
#   - Context: 32K tokens
#   - Speed: SUPER FAST!

# Model: gemma2-9b-it
#   - Input:  $0.20 per 1M tokens
#   - Output: $0.20 per 1M tokens
#   - Context: 8K tokens
#   - Speed: EXTREMELY FAST!

# ===================================
# RECOMMENDATION FOR YOUR USE CASE
# ===================================
# Start with: llama-3.3-70b-versatile
# - Best quality for SQL generation
# - 128K context (handles large schemas)
# - Free tier covers testing
# - Only $0.59-0.79/M tokens when you scale

# If you need SPEED over quality:
# Use: mixtral-8x7b-32768
# - Fastest inference
# - Still good for SQL
# - Cheaper: $0.24/M tokens
