# ===================================
# GROQ API CONFIGURATION - COMPLETE MODEL LIST
# ===================================
# Copy these settings to your .env file

# Your Groq API Key (Get from: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
CUSTOM_MODEL_API_KEY=your_groq_api_key_here

# Groq API Base URL (DO NOT CHANGE)
CUSTOM_MODEL_BASE_URL=https://api.groq.com/openai/v1

# Enable custom model
USE_CUSTOM_MODEL=true

# ===================================
# SELECT YOUR MODEL (Choose ONE)
# ===================================

# OPTION 1: GPT-OSS-120B (From your screenshot!) ⭐ RECOMMENDED FOR QUALITY
CUSTOM_MODEL_NAME=openai/gpt-oss-120b
# - Best quality from GPT-OSS family
# - 128K context window
# - Great for complex SQL queries
# - Pricing: $0.15 input / $0.60 output per 1M tokens

# OPTION 2: GPT-OSS-20B (Faster, cheaper)
# CUSTOM_MODEL_NAME=openai/gpt-oss-20b
# - Faster than 120B
# - 128K context window
# - Good for simpler queries
# - Pricing: $0.05 input / $0.20 output per 1M tokens

# OPTION 3: Llama 3.3 70B Versatile (Most popular)
# CUSTOM_MODEL_NAME=llama-3.3-70b-versatile
# - Excellent all-rounder
# - 128K context
# - Great SQL generation
# - Pricing: $0.59 input / $0.79 output per 1M tokens

# OPTION 4: Llama 3.1 70B Versatile
# CUSTOM_MODEL_NAME=llama-3.1-70b-versatile
# - Proven model
# - 128K context
# - Pricing: $0.59 input / $0.79 output per 1M tokens

# OPTION 5: Llama 3.2 90B Text Preview
# CUSTOM_MODEL_NAME=llama-3.2-90b-text-preview
# - Larger model
# - 128K context
# - Pricing: $0.59 input / $0.79 output per 1M tokens

# OPTION 6: Mixtral 8x7B (FASTEST!)
# CUSTOM_MODEL_NAME=mixtral-8x7b-32768
# - SUPER FAST inference
# - 32K context
# - Good balance
# - Pricing: $0.24 input / $0.24 output per 1M tokens

# OPTION 7: Gemma 2 9B IT (Smallest, fastest)
# CUSTOM_MODEL_NAME=gemma2-9b-it
# - ULTRA FAST
# - 8K context
# - Simple tasks
# - Pricing: $0.20 input / $0.20 output per 1M tokens

# OPTION 8: Llama 3.1 8B Instant
# CUSTOM_MODEL_NAME=llama-3.1-8b-instant
# - Very fast
# - 128K context
# - Basic queries
# - Pricing: $0.05 input / $0.08 output per 1M tokens

# OPTION 9: Llama 3 8B
# CUSTOM_MODEL_NAME=llama3-8b-8192
# - Fast, smaller model
# - 8K context
# - Simple tasks
# - Pricing: $0.05 input / $0.08 output per 1M tokens

# OPTION 10: Llama 3 70B
# CUSTOM_MODEL_NAME=llama3-70b-8192
# - Good quality
# - 8K context
# - Pricing: $0.59 input / $0.79 output per 1M tokens

# ===================================
# RECOMMENDED MODELS BY USE CASE
# ===================================

# For COMPLEX SQL queries with large schemas:
#   → openai/gpt-oss-120b (BEST QUALITY)
#   → llama-3.3-70b-versatile (BALANCED)

# For FAST responses:
#   → mixtral-8x7b-32768 (FASTEST + GOOD)
#   → openai/gpt-oss-20b (FAST + CHEAP)

# For COST optimization:
#   → openai/gpt-oss-20b ($0.05/$0.20)
#   → gemma2-9b-it ($0.20/$0.20)

# For TESTING (FREE TIER):
#   → Any model! Free tier: 30 req/min, 14,400/day

# ===================================
# PRICING COMPARISON
# ===================================

# Model                      Input     Output    Context  Speed
# openai/gpt-oss-120b        $0.15     $0.60     128K     Fast
# openai/gpt-oss-20b         $0.05     $0.20     128K     Very Fast
# llama-3.3-70b-versatile    $0.59     $0.79     128K     Fast
# mixtral-8x7b-32768         $0.24     $0.24     32K      Super Fast
# gemma2-9b-it               $0.20     $0.20     8K       Ultra Fast

# ===================================
# FREE TIER LIMITS
# ===================================
# All models share the same limits:
# - 30 requests per minute
# - 14,400 requests per day
# - 6,000 tokens per minute
# - No credit card required!

# ===================================
# ADVANCED SETTINGS (Optional)
# ===================================

# Temperature (0.0 = deterministic, 2.0 = creative)
TEMPERATURE=0.3

# Max output tokens
MAX_OUTPUT_TOKEN=4096

# ===================================
# Keep your existing ADK settings
# ===================================
# ROOT_AGENT_MODEL=gemini-2.5-flash
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True
