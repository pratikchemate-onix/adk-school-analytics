# Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=search-ahmed
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# BigQuery Authentication
# Optional: Only needed if using a Service Account key
# If not set, will use gcloud ADC (gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/sa-key.json

# Allowed GCP projects for BigQuery (comma-separated)
ALLOWED_PROJECTS=search-ahmed

# Agent Configuration
# To use gemini-3.5-flash: set ROOT_AGENT_MODEL=gemini-3.5-flash and GOOGLE_CLOUD_LOCATION=global
ROOT_AGENT_MODEL=gemini-2.5-flash
BQ_RESULT_LIMIT=100
BQ_MAX_QUERIES_PER_INVOCATION=10
MAX_OUTPUT_TOKEN=4096
TEMPERATURE=0.1

# Stock Market Data APIs
# Twelve Data: free key at https://twelvedata.com/pricing (Basic/free plan)
# Free tier: 800 requests/day, 8 requests/minute — verify current limits at
# https://twelvedata.com/pricing before relying on this in production.
TWELVE_DATA_API_KEY=

# Alpha Vantage: free key at https://www.alphavantage.co/support/#api-key
# Free tier has a very low daily quota (historically ~25 requests/day, 5/min) —
# verify current limits at https://www.alphavantage.co/premium/ before relying on
# this beyond light testing/demo usage.
ALPHA_VANTAGE_API_KEY=

# Optional tuning for stock tools (defaults shown)
# STOCK_TOOLS_HTTP_TIMEOUT=10
# STOCK_QUOTE_CACHE_TTL=60
# STOCK_PROFILE_CACHE_TTL=86400
# STOCK_HISTORICAL_CACHE_TTL=3600
# STOCK_FUNDAMENTALS_CACHE_TTL=86400
# STOCK_SYMBOL_SEARCH_CACHE_TTL=86400

# Indian market (NSE/BSE) coverage: tickers with a ".NS" or ".BO" suffix are
# routed to Yahoo Finance (yfinance) instead of Twelve Data/Alpha Vantage,
# since their free tiers don't cover Indian exchanges. No API key needed —
# yfinance is an unofficial, unsupported scraper library with no SLA.
